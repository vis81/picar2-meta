  # Fork carrying one commit on upstream 1.3.12: the Smac analytic-expansion
  # scoring fix (docs/nav2-smac-right-turn.md). Only nav2_smac_planner is built
  # from here -- make deps COLCON_IGNOREs the rest -- and its sources are
  # identical in 1.3.11 and 1.3.12, so this one branch serves the PC (nav2
  # 1.3.12) and the Pi image (1.3.11) alike.
  navigation2:
    type: git
    url: https://github.com/vis81/navigation2.git
    version: picar2/1.3.12
